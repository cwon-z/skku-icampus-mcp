# Copy to .env and chmod 600. Never commit .env.
# Make each token with:  openssl rand -hex 24
# Every "label:token" entry needs a token; delete the ones you don't use (an empty token stops startup).

# --- collector + REST API ---------------------------------------------------
ICAMPUS_USERNAME=
# Single quotes keep compose from expanding a "$" inside the password (write a ' as \').
# Local runs read .env with python-dotenv, which still expands "${...}" and collapses "\\": if your
# password contains those, export ICAMPUS_PASSWORD in the shell for local runs instead.
ICAMPUS_PASSWORD=''
# label:token pairs. "mcp" is for the MCP container; "admin" may clear a login block (retry_login).
ICAMPUS_API_TOKENS=mcp:,admin:
# ICAMPUS_TERM=2026년 2학기                    # default: detected from Canvas
# ICAMPUS_SYNC_TIMES=07:30,12:30,18:00,22:30   # empty = no schedule
# ICAMPUS_KUMA_PUSH_URL=http://<uptime-kuma>/api/push/<id>   # optional heartbeat

# --- MCP server ---------------------------------------------------------------
# The same token as "mcp:" above.
ICAMPUS_MCP_API_TOKEN=
# Tokens for clients that connect directly, label:token (e.g. laptop:<token>)
ICAMPUS_MCP_TOKENS=laptop:
# Public route through Cloudflare Access (leave empty if you don't use it)
ICAMPUS_MCP_ACCESS_TEAM=     # e.g. myteam.cloudflareaccess.com (no https://)
ICAMPUS_MCP_ACCESS_AUD=      # the Access app's AUD tag(s), comma-separated
ICAMPUS_MCP_ACCESS_EMAILS=   # comma list of emails allowed in
# Host headers the MCP endpoint accepts; add your public hostname when using the Access route
# ICAMPUS_MCP_ALLOWED_HOSTS=mcp.example.com,127.0.0.1:*

# --- server binds (see compose.homelab.example.yaml) ------------------------------
# COMPOSE_FILE=compose.yaml:compose.homelab.yaml
